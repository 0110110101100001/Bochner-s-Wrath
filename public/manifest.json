{
  "manifest_version": 3,
  "name": "Builder's Tab",
  "version": "2.3.1",
  "description": "Your new tab is now a village. The Builder is not thrilled about it.",
  "minimum_chrome_version": "110",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["storage", "favicon"],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
